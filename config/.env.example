# Copy this file to .env and fill in your own free keys/tokens.
# Never commit your real .env file.

# --- Pexels (free stock video/photos) ---
# Get one at https://www.pexels.com/api/ (instant, free, no credit card)
PEXELS_API_KEY=

# --- Freesound (free SFX library) ---
# Get one at https://freesound.org/apiv2/apply/ (free account + API key)
FREESOUND_API_KEY=

# --- YouTube Data API ---
# Create a project at https://console.cloud.google.com/
# Enable "YouTube Data API v3", create OAuth Client ID (Desktop app),
# download as config/client_secret.json (see README for exact steps).
YOUTUBE_CHANNEL_ID=

# --- Discord ---
# Create a bot at https://discord.com/developers/applications (free)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Pipeline config ---
VIDEO_TOPIC=history
UPLOADS_PER_DAY=6
OLLAMA_MODEL=llama3.2   # only used if Ollama is installed locally; safe to leave as-is
